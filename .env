# Backend API URL
# ------------------------------------------------------------------------------
# Leave this COMMENTED OUT so it defaults to '/api'.
# We use a proxy in vite.config.js for local development to bypass CORS.
# We also use a proxy in public/_redirects for Netlify production to bypass CORS.
# VITE_API_URL=https://api.advitacredit.com/api

# CIBIL Score & Report API Base URL
VITE_CIBIL_API_URL=https://api.advitacredit.com

# KYC Verification API Base URL
VITE_KYC_API_URL=https://api.advitacredit.com
VITE_KYC_REDIRECT_URL=https://www.epochconverter.com/

